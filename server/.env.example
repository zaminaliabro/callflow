# --- PostgreSQL connection (Prisma) ---
# Local:    postgresql://USER:PASSWORD@localhost:5432/callflow?schema=public
# Neon:     postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/callflow?sslmode=require
# Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/callflow?schema=public"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"

# --- Seed admin credentials ---
SEED_ADMIN_EMAIL="admin@callflow.test"
SEED_ADMIN_PASSWORD="admin123"
