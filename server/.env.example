# ── PostgreSQL (Prisma) ──────────────────────────────────────────────
# LOCAL dev — a single local connection is fine:
#   DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/callflow?schema=public"
#
# SUPABASE (for Vercel) — use BOTH, from Project Settings → Database → Connection string:
#   DATABASE_URL = "Connection pooling" string, port 6543, add ?pgbouncer=true
#   DIRECT_URL   = "Direct connection" string, port 5432
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Server (local only; Vercel sets its own) ─────────────────────────
PORT=5000
CLIENT_ORIGIN="http://localhost:5173"

# ── Seed admin credentials ───────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@callflow.test"
SEED_ADMIN_PASSWORD="admin123"
